# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored. Never commit real values.

# Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Only for applying migrations with the Supabase CLI. The app never reads it.
# SUPABASE_DB_URL=

# The vendor's photo suggestions (OpenRouter). Server only: no NEXT_PUBLIC_
# prefix, so these never reach the browser. On Vercel, set them in
# Project Settings -> Environment Variables.
# OPENROUTER_MODEL is any vision-capable model ID from openrouter.ai/models,
# for example anthropic/claude-haiku-5.5. Change it here to switch models.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Optional, for tests only: send the calls somewhere else (a local stand-in).
# OPENROUTER_BASE_URL=

# Online payment through MyFatoorah, SANDBOX (test) mode only. Server only.
# MYFATOORAH_API_KEY is MyFatoorah's published Kuwait test token:
# docs.myfatoorah.com/docs/api-key, "Test (Demo) Token".
# PAYMENTS_SERVER_SECRET is a random string of 32 characters or more that you
# make up. Its SHA-256 hash goes into the database once (see README).
MYFATOORAH_API_KEY=
PAYMENTS_SERVER_SECRET=
